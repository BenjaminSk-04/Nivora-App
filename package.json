{
  "name": "nivora",
  "version": "1.7.0",
  "private": true,
  "description": "Nivora — finance & health PWA",
  "scripts": {
    "css": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --minify",
    "css:watch": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --watch",
    "dev": "npm run css && npx --yes serve . -l 5173",
    "build": "node scripts/build.mjs",
    "preview": "npx --yes serve dist -l 4173"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
