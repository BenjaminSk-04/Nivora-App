{
  "name": "nivora",
  "version": "1.0.0",
  "private": true,
  "description": "Nivora \u2014 finance & health PWA",
  "scripts": {
    "css": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --minify",
    "css:watch": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --watch",
    "dev": "npm run css && npx --yes serve . -l 5173",
    "build": "node scripts/build.mjs",
    "preview": "npx --yes serve dist -l 4173",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@capacitor/cli": "^8.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
